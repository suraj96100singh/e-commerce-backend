{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="page-title">Product List</h1>
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Price (Excl. VAT)</th>
                    <th>Category</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.title }}</td>
                        <td>${{ product.priceExclVat }}</td>
                        <td>{{ product.category }}</td>
                        <td>
                            <a href="{{ path('product_detail', {'id': product.id}) }}" class="btn">View Details</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="no-data">No products available</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
